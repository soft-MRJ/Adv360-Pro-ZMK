#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4       &kp N5  &tog 1                                                    &mo 3        &kp N6  &kp N7          &kp N8         &kp N9      &kp N0              &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T   &none                                                     &none        &kp Y   &kp U           &kp I          &kp O       &kp P               &kp LEFT_BRACKET
&kp ESC    &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G   &none     &kp LCTRL  &kp LALT       &kp LGUI   &kp TAB    &none        &kp H   &mt RSHFT J     &mt RCTRL K    &mt RALT L  &mt RGUI SEMICOLON  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B                        &lt 1 END      &kp PG_UP                          &kp N   &kp M           &kp COMMA      &kp DOT     &kp FSLH            &kp RSHFT
&mo 2      &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT            &kp BSPC  &kp DEL    &kp ESC        &kp PG_DN  &kp ENTER  &lt 2 SPACE          &kp LS(PERIOD)  &kp LS(COMMA)  &kp LBKT    &kp RBKT            &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans   &trans  &trans  &trans  &trans                                                   &trans     &trans      &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&trans  &trans  &kp F12  &kp F8  &kp F4  &trans  &none                                                    &none      &trans      &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&trans  &trans  &kp F11  &kp F7  &kp F3  &trans  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp LS(N5)  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&trans  &trans  &kp F10  &kp F6  &kp F2  &trans                       &kp HOME      &kp PG_UP                        &trans      &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&trans  &trans  &kp F9   &kp F5  &kp F1          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE              &kp KP_N0   &kp COMMA     &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        Symbol {
            display-name = "Kp";
            bindings = <
&kp LS(EQUAL)          &kp EQUAL              &kp LS(N8)     &kp LS(N9)     &trans               &trans             &trans                                                     &trans  &trans          &trans          &trans        &trans           &trans  &trans
&kp LS(N1)             &kp RA(N7)             &kp BACKSLASH  &kp LS(N2)     &kp RA(N0)           &kp LS(KP_PLUS)    &none                                                      &none   &trans          &trans          &trans        &trans           &trans  &trans
&kp LS(NUMBER_3)       &kp LS(RIGHT_BRACKET)  &kp LS(N0)     &kp LS(SLASH)  &kp RA(NUMBER_4)     &kp LS(BACKSLASH)  &none       &trans             &trans      &trans  &trans  &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&kp RA(NUMBER_2)       &kp NON_US_BSLH        &kp RA(EQUAL)  &kp LS(SLASH)  &kp LS(NON_US_BSLH)  &kp LS(N7)                                        &trans      &trans                  &kp RA(N7)      &kp LS(N8)      &kp LS(N9)    &kp RA(N0)       &trans  &trans
&kp RA(RIGHT_BRACKET)  &kp LS(N6)             &kp RA(N8)     &kp RA(N9)     &kp LS(KP_PLUS)                         &kp LS(N5)  &kp RA(LESS_THAN)  &trans      &trans  &trans  &trans                  &kp RA(N8)      &kp RA(N9)    &trans           &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
